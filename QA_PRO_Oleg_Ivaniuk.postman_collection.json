    {
      "name": "Create Expense",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const initialMileage = Number(pm.collectionVariables.get(\"initialMileage\"));\r",
              "\r",
              "let lastMileage = pm.collectionVariables.get(\"lastMileage\");\r",
              "\r",
              "if (!lastMileage) {\r",
              "    lastMileage = initialMileage;\r",
              "} else {\r",
              "    lastMileage = Number(lastMileage);\r",
              "}\r",
              "\r",
              "const newMileage = lastMileage + 10;\r",
              "\r",
              "pm.collectionVariables.set(\"newExpenseMileage\", newMileage);\r",
              "\r",
              "const today = new Date().toISOString().split('T')[0];\r",
              "pm.collectionVariables.set(\"today\", today);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.test(\"Response status is ok\", function () {",
              "    pm.expect(response.status).to.eql(\"ok\");",
              "});",
              "",
              "pm.collectionVariables.set(\"lastMileage\", response.data.mileage);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"carId\": \"{{carID}}\",\r\n  \"reportedAt\": \"{{today}}\",\r\n  \"mileage\": {{newExpenseMileage}},\r\n  \"liters\": 22,\r\n  \"totalCost\": 22,\r\n  \"forceMileage\": false\r\n}",
