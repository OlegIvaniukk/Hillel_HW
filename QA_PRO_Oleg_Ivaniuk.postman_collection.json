    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let createdRandomEmail = `test_${Date.now()}@gmail.com`\r",
              "let emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r",
              "if (!emailRegex.test(createdRandomEmail)) {\r",
              "    throw new Error(\"Generated email has invalid format\");\r",
              "}\r",
              "pm.collectionVariables.set(\"createdRandomEmail\", createdRandomEmail)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var schema = {\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"status\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"data\": {\r",
              "      \"type\": \"object\",\r",
              "      \"properties\": {\r",
              "        \"userId\": {\r",
              "          \"type\": \"integer\"\r",
              "        },\r",
              "        \"photoFilename\": {\r",
              "          \"type\": \"string\"\r",
              "        },\r",
              "        \"distanceUnits\": {\r",
              "          \"type\": \"string\"\r",
              "        },\r",
              "        \"currency\": {\r",
              "          \"type\": \"string\"\r",
              "        }\r",
              "      },\r",
              "      \"required\": [\r",
              "        \"userId\",\r",
              "        \"photoFilename\",\r",
              "        \"distanceUnits\",\r",
              "        \"currency\"\r",
              "      ]\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"status\",\r",
              "    \"data\"\r",
              "  ]\r",
              "}\r",
              "\r",
              "pm.test('schema', ()=>{pm.response.to.have.jsonSchema(schema)})\r",
              "\r",
              "let response = pm.response.json();\r",
              "pm.collectionVariables.set(\"userId\", response.data.userId);\r",
              "pm.collectionVariables.set(\"userId\", response.data.userId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"{{$randomFirstName}}\",\r\n  \"lastName\": \"{{$randomLastName}}\",\r\n  \"email\": \"{{createdRandomEmail}}\",\r\n  \"password\": \"{{pwd}}\",\r\n  \"repeatPassword\": \"{{pwd}}\"\r\n}",
