    {
      "name": "Update User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// name\r",
              "pm.collectionVariables.set(\"name\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));\r",
              "\r",
              "// lastName\r",
              "pm.collectionVariables.set(\"lastName\", pm.variables.replaceIn(\"{{$randomLastName}}\"));\r",
              "\r",
              "// randomBirthDate\r",
              "const randomBirthDate = new Date(\r",
              "  1980 + Math.floor(Math.random() * 20),\r",
              "  Math.floor(Math.random() * 12),\r",
              "  Math.floor(Math.random() * 28)\r",
              ").toISOString();\r",
              "\r",
              "pm.collectionVariables.set(\"randomBirthDate\", randomBirthDate);\r",
              "\r",
              "// randomCountry\r",
              "const countries = [\"Ukraine\", \"Poland\", \"Germany\", \"France\"];\r",
              "const randomCountry = countries[Math.floor(Math.random() * countries.length)];\r",
              "pm.collectionVariables.set(\"randomCountry\", randomCountry);\r",
              "\r",
              "// randomPhoto\r",
              "const photoName = `user-${Date.now()}.jpg`;\r",
              "pm.collectionVariables.set(\"randomPhoto\", photoName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "var response = pm.response.json();\r",
              "var responseData = response.data;\r",
              "\r",
              "var requestBody = JSON.parse(pm.request.body.raw);\r",
              "\r",
              "pm.test(\"Profile data matches request\", function () {\r",
              "    pm.expect(responseData.name).to.eql(requestBody.name);\r",
              "    pm.expect(responseData.lastName).to.eql(requestBody.lastName);\r",
              "    pm.expect(responseData.country).to.eql(requestBody.country);\r",
              "    pm.expect(responseData.dateBirth).to.eql(requestBody.dateBirth);\r",
              "});\r",
              "\r",
              "pm.test(\"dateBirth is valid ISO format\", function () {\r",
              "    var date = new Date(responseData.dateBirth);\r",
              "    pm.expect(date.toString()).to.not.eql(\"Invalid Date\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
