    {
      "name": "Create New Car",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responce = pm.response.json();\r",
              "pm.collectionVariables.set(\"carID\", responce.data.id);\r",
              "// Capture car's current mileage so Create Expense doesn't send a lower one (would 400).\r",
              "pm.collectionVariables.set(\"initialMileage\", responce.data.mileage);\r",
              "// Reset lastMileage between Newman iterations so DEV/PROD don't bleed into each other.\r",
              "pm.collectionVariables.unset(\"lastMileage\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"carBrandId\": 1,\r\n  \"carModelId\": 1,\r\n  \"mileage\": 122\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/cars",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cars"
          ]
        }
      },
      "response": []
