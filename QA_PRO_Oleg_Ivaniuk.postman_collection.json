  "item": [
    {
      "name": "User Validation Tests",
      "item": [
        {
          "name": "Create User - name error validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status is 400\", function () {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});\r",
                  "\r",
                  "pm.test(`Name validation - \"${pm.variables.get(\"testName\")}\"`, function () {\r",
                  "    pm.expect(response.message).to.eql(pm.variables.get(\"expectedMessage\"));\r",
                  "});\r",
                  "\r",
                  "// Loop through 4 test cases for the current Newman iteration / env.\r",
                  "// Env switching happens between Newman iterations (see collection prerequest).\r",
                  "var testCasesLength = 4;\r",
                  "var iteration = pm.collectionVariables.get(\"iteration\") || 0;\r",
                  "iteration = Number(iteration);\r",
                  "\r",
                  "if (iteration < testCasesLength - 1) {\r",
                  "    iteration++;\r",
                  "    pm.collectionVariables.set(\"iteration\", iteration);\r",
                  "    pm.execution.setNextRequest(pm.info.requestName);\r",
                  "} else {\r",
                  "    // Reset for the next Newman iteration and continue to the next request.\r",
                  "    pm.collectionVariables.set(\"iteration\", 0);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// baseUrl is set by the collection-level prerequest based on Newman iteration.\r",
                  "// This script only prepares the test case for the current loop step.\r",
                  "var randomEmail = `test_${Date.now()}@gmail.com`;\r",
                  "pm.variables.set(\"randomEmail\", randomEmail);\r",
                  "\r",
                  "var testCases = [\r",
                  "    { name: \"\", expectedMessage: '\"name\" is not allowed to be empty' },\r",
                  "    { name: \"1\", expectedMessage: \"Name has to be from 2 to 20 characters long\" },\r",
                  "    { name: \"123456789012345678901\", expectedMessage: \"Name has to be from 2 to 20 characters long\" },\r",
                  "    { name: \"$$$\", expectedMessage: \"Name is invalid\" }\r",
                  "];\r",
                  "\r",
                  "var iteration = pm.collectionVariables.get(\"iteration\") || 0;\r",
                  "iteration = Number(iteration);\r",
                  "\r",
                  "var testCase = testCases[iteration];\r",
                  "\r",
                  "pm.variables.set(\"testName\", testCase.name);\r",
                  "pm.variables.set(\"expectedMessage\", testCase.expectedMessage);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{testName}}\",\r\n  \"lastName\": \"{{$randomLastName}}\",\r\n  \"email\": \"{{randomEmail}}\",\r\n  \"password\": \"{{pwd}}\",\r\n  \"repeatPassword\": \"{{pwd}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        }
      ],
