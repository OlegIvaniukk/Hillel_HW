  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Pick env per iteration from data.json (passed via `newman run ... -d data.json`).\r",
          "// If no data file is supplied (e.g. running directly in Postman desktop),\r",
          "// fall back to whatever baseUrl the loaded environment file defines.\r",
          "var dataBaseUrl = pm.iterationData.get(\"baseUrl\");\r",
          "var dataEnvName = pm.iterationData.get(\"envName\");\r",
          "\r",
          "if (dataBaseUrl) {\r",
          "    pm.variables.set(\"baseUrl\", dataBaseUrl);\r",
          "}\r",
          "pm.variables.set(\"currentEnv\", dataEnvName || (pm.environment.name || \"unknown\"));"
        ]
      }
    },
